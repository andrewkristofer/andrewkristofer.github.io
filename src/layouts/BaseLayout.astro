---
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import WaybarNav from '../components/WaybarNav.astro';
import KeybindingHUD from '../components/KeybindingHUD.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090a10" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="relative min-h-screen overflow-x-hidden bg-celestial-void font-sans text-ink">
    <!-- Aurora backdrop: three blurred, drifting colour blobs (decorative, non-interactive). -->
    <div class="pointer-events-none fixed inset-0 overflow-hidden" aria-hidden="true">
      <div
        class="absolute -left-40 -top-40 h-[36rem] w-[36rem] animate-float rounded-full bg-celestial-violet/[0.14] blur-3xl"
      >
      </div>
      <div
        class="absolute -right-32 top-1/3 h-[32rem] w-[32rem] animate-drift rounded-full bg-celestial-cyan/[0.10] blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-[-12rem] left-1/4 h-[30rem] w-[30rem] animate-float rounded-full bg-fuchsia-500/[0.08] blur-3xl"
      >
      </div>
      <!-- Star grid: faint dotted radial-gradient overlay adding depth. -->
      <div
        class="absolute inset-0 opacity-[0.35]"
        style="background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 28px 28px;"
      >
      </div>
    </div>
    <!-- Film grain: SVG fractal-noise overlay for a subtle textured finish. -->
    <div
      class="pointer-events-none fixed inset-0 z-40 opacity-[0.035] mix-blend-overlay"
      aria-hidden="true"
      style="background-image: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22160%22 height=%22160%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%222%22 stitchTiles=%22stitch%22/></filter><rect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/></svg>');"
    >
    </div>

    <WaybarNav />

    <main class="relative z-10">
      <slot />
    </main>

    <footer class="relative z-10 border-t border-white/5 px-6 pb-24 pt-10">
      <div class="mx-auto flex max-w-5xl flex-col items-center gap-3 text-center">
        <span class="font-mono text-[11px] tracking-wider text-ink-faint">
          © 2026 Andrew Kristofer Jian · hand-crafted with
          <span class="text-celestial-cyan">astro</span> +
          <span class="text-celestial-violet">tailwind</span>
        </span>
        <span class="font-mono text-[10px] tracking-widest text-ink-faint/60">
          ~/built-on-wayland-vibes
        </span>
      </div>
    </footer>

    <KeybindingHUD />

    <script>
      /**
       * @file        Window-manager script (inline, vanilla JS — zero hydration).
       * @description Implements a Hyprland-like window manager for the single-page
       *              layout. The "home" section is the desktop; every other section
       *              opens as a centred floating window. Windows are opened, closed,
       *              and cycled through keyboard shortcuts, dock-pill clicks, and deep
       *              links, while CSS entrance animations replay on each open.
       * @keybindings
       *   ↓ / ↑     → open next / previous window (cycles)
       *   Z + Q     → desktop: close all windows
       *   Z + 1..5  → workspace jump, mirroring the Waybar pills:
       *               1 about · 2 exp · 3 projects · 4 certs · 5 skills
       *   Esc       → close the focused window
       * @remarks    Clicking a dock pill opens (or toggles) its window; clicking the
       *             dimmed backdrop or the ✕ button closes the focused one. Deep
       *             links such as #projects open that window on load.
       */
      /**
       * Canonical section order used for arrow-key cycling (↓ next / ↑ previous).
       * The 'home' entry represents the desktop and serves as the cycle anchor.
       */
      const SECTION_ORDER = [
        'home',
        'about',
        'experience',
        'projects',
        'certifications',
        'skills',
      ];
      /**
       * Maps the "Z + <key>" workspace-jump combos to their target section ids,
       * mirroring the Waybar dock pills (q → desktop, 1-5 → windows).
       */
      const COMBO_TARGETS = {
        'q': 'home',
        '1': 'about',
        '2': 'experience',
        '3': 'projects',
        '4': 'certifications',
        '5': 'skills',
      };

      /** Registry of window elements keyed by their `data-window` id. */
      const windows = new Map();
      document.querySelectorAll('[data-window]').forEach((el) => {
        windows.set(el.getAttribute('data-window'), el);
      });
      /** Dock-pill anchor links whose active state tracks the focused window. */
      const navLinks = Array.from(document.querySelectorAll('[data-nav-link]'));
      /** Sliding workspace indicator (spec #12); repositioned by `setActive()`. */
      const wsIndicator = document.querySelector('[data-nav-indicator]');
      /** Nav link currently marked active, or `null` while on the desktop. */
      let activeNav = null;

      /**
       * Replay CSS entrance animations under `root` (spec #17) by briefly applying
       * the `.anim-reset` class, forcing a reflow, then removing it so animations
       * restart from 0%.
       *
       * @param {Element|null|undefined} root - Container whose animations should restart.
       * @returns {void}
       */
      function restartAnimations(root) {
        if (!root) return;
        root.classList.add('anim-reset');
        // Force a reflow so the .anim-reset styles apply before removal.
        void root.getBoundingClientRect().width;
        root.classList.remove('anim-reset');
      }

      /** Whether the "Z" modifier key is currently held for workspace combos. */
      let zHeld = false;
      /** Id of the currently open window, or `null` while on the desktop. */
      let openId = null;

      /**
       * Trigger the keybinding HUD flash to acknowledge a hotkey press.
       *
       * @returns {void}
       */
      function flashHud() {
        const hud = document.getElementById('keybinding-hud');
        if (!hud) return;
        hud.classList.remove('hud-flash');
        // Force a reflow so the flash animation restarts cleanly.
        void hud.offsetWidth;
        hud.classList.add('hud-flash');
      }

      /**
       * Mark the dock pill matching `id` as active and realign the sliding
       * workspace indicator.
       *
       * @param {string} id - Section id to highlight (e.g. "about"); non-matching pills are cleared.
       * @returns {void}
       */
      function setActive(id) {
        activeNav = null;
        navLinks.forEach((link) => {
          const isActive = link.getAttribute('href') === `#${id}`;
          link.setAttribute('data-active', String(isActive));
          if (isActive) activeNav = link;
        });
        moveWsIndicator();
      }

      /**
       * Slide the workspace indicator (spec #12) beneath the active pill, or hide
       * it when no pill is active (i.e. while on the desktop).
       *
       * @returns {void}
       */
      function moveWsIndicator() {
        if (!wsIndicator || !wsIndicator.parentElement) return;
        if (!activeNav) {
          wsIndicator.style.opacity = '0';
          return;
        }
        const container = wsIndicator.parentElement;
        const delta =
          activeNav.getBoundingClientRect().left -
          container.getBoundingClientRect().left;
        wsIndicator.style.opacity = '1';
        wsIndicator.style.width = `${activeNav.getBoundingClientRect().width}px`;
        wsIndicator.style.transform = `translateX(${delta}px)`;
      }

      window.addEventListener('resize', moveWsIndicator);
      if (wsIndicator && wsIndicator.parentElement) {
        wsIndicator.parentElement.addEventListener('scroll', moveWsIndicator, {
          passive: true,
        });
      }

      /**
       * Close any open window and return to the desktop ("home").
       *
       * @param {boolean} [flash=true] - Whether to flash the keybinding HUD to acknowledge the action.
       * @returns {void}
       */
      function showDesktop(flash = true) {
        windows.forEach((win) => win.removeAttribute('data-open'));
        openId = null;
        document.body.classList.remove('window-open');
        setActive('home');
        history.replaceState(null, '', '#home');
        if (flash) flashHud();
      }

      /**
       * Open the window registered under `id`, closing any other open window and
       * replaying its entrance animations. Re-opening the currently focused window
       * toggles it closed.
       *
       * @param {string|null} id      - Target window id; `null` or "home" returns to the desktop.
       * @param {boolean}     [flash=true] - Whether to flash the keybinding HUD to acknowledge the action.
       * @returns {void}
       */
      function openWindow(id, flash = true) {
        if (!id || id === 'home') {
          showDesktop(flash);
          return;
        }
        if (openId === id) {
          // Toggle: re-opening the focused window closes it.
          showDesktop(flash);
          return;
        }
        const win = windows.get(id);
        if (!win) return;
        windows.forEach((w) => w.removeAttribute('data-open'));
        win.setAttribute('data-open', '');
        restartAnimations(win.querySelector('.window-panel'));
        openId = id;
        document.body.classList.add('window-open');
        setActive(id);
        history.replaceState(null, '', `#${id}`);
        if (flash) flashHud();
        const panel = win.querySelector('.window-panel');
        if (panel) panel.focus({ preventScroll: true });
      }

      /**
       * Cycle to the next (`dir` = 1) or previous (`dir` = -1) window in
       * `SECTION_ORDER`, wrapping around at the ends of the list.
       *
       * @param {number} dir - Direction to move: +1 forward, -1 backward.
       * @returns {void}
       */
      function navigate(dir) {
        const cur = Math.max(0, SECTION_ORDER.indexOf(openId ?? 'home'));
        const next = (cur + dir + SECTION_ORDER.length) % SECTION_ORDER.length;
        openWindow(SECTION_ORDER[next]);
      }

      /**
       * Determine whether a keyboard event target is a text-entry element, so
       * global hotkeys never interfere with typing.
       *
       * @param {EventTarget|null} target - The event target to inspect.
       * @returns {boolean} `true` when the target is an input, textarea, select, or contenteditable element.
       */
      function isTypingTarget(target) {
        if (!(target instanceof Element)) return false;
        return Boolean(
          target.closest('input, textarea, select, [contenteditable="true"]'),
        );
      }

      /**
       * Global keydown handler implementing the window-manager keyboard controls:
       * Escape closes the focused window, "Z" arms workspace combos, "Z + <key>"
       * jumps to a window, and ↑/↓ cycle through windows. Text-entry targets and
       * modifier chords (Ctrl/Meta/Alt) are ignored.
       */
      window.addEventListener('keydown', (e) => {
        if (isTypingTarget(e.target) || e.ctrlKey || e.metaKey || e.altKey) return;

        if (e.key === 'Escape') {
          if (openId) showDesktop();
          return;
        }

        if (e.key.toLowerCase() === 'z') {
          zHeld = true;
          return;
        }

        const comboKey = e.key.toLowerCase();
        if (zHeld && COMBO_TARGETS[comboKey]) {
          e.preventDefault();
          openWindow(COMBO_TARGETS[comboKey]);
          return;
        }

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          navigate(1);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          navigate(-1);
        }
      });

      /** Release the "Z" combo modifier when its key comes back up. */
      window.addEventListener('keyup', (e) => {
        if (e.key.toLowerCase() === 'z') zHeld = false;
      });
      /** Reset the "Z" combo modifier if the window loses focus mid-chord. */
      window.addEventListener('blur', () => {
        zHeld = false;
      });

      /**
       * Mouse: dock pills and in-page anchor links open (or toggle) their target
       * window instead of performing a native hash navigation.
       */
      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (e) => {
          const id = (link.getAttribute('href') || '').slice(1);
          if (windows.has(id) || id === 'home') {
            e.preventDefault();
            openWindow(id);
          }
        });
      });

      /** Mouse: close the focused window via the ✕ button or the dimmed backdrop. */
      document.querySelectorAll('[data-window-close]').forEach((el) => {
        el.addEventListener('click', () => showDesktop());
      });

      /**
       * Deep links: a hash such as #about opens that window on load; otherwise
       * fall back to the desktop.
       */
      const initial = location.hash.slice(1);
      if (initial && windows.has(initial)) {
        openWindow(initial, false);
      } else {
        setActive('home');
      }
    </script>
  </body>
</html>
