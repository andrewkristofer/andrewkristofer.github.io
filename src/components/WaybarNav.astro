---
/**
 * @component WaybarNav
 * @description Floating top dock / navbar in the Waybar style. Renders a
 *              glassmorphic pill container with a logo, workspace-indicator
 *              pills (1-5) that double as section anchors, and an "available"
 *              status module. The active state is toggled by the layout's
 *              window-manager script via `data-active` and the sliding indicator.
 * @remarks     Workspace pills map to sections: 1 about · 2 exp · 3 projects ·
 *              4 certs · 5 skills.
 */
import Tooltip from '@astroanimate/core/Tooltip';

const links = [
  { id: 'about', ws: '1', label: 'about' },
  { id: 'experience', ws: '2', label: 'exp' },
  { id: 'projects', ws: '3', label: 'projects' },
  { id: 'certifications', ws: '4', label: 'certs' },
  { id: 'skills', ws: '5', label: 'skills' },
];
---

<header class="fixed inset-x-0 top-0 z-50 flex justify-center px-4 pt-4">
  <nav
    class="flex w-full max-w-5xl items-center justify-between gap-3 rounded-full border border-white/10 bg-white/[0.035] px-3 py-2 shadow-panel backdrop-blur-2xl"
  >
    <!-- Logo / window-title link; clicking returns to the desktop (#home). -->
    <a
      href="#home"
      class="group flex shrink-0 items-center gap-2 rounded-full px-2 py-1 transition-colors hover:bg-white/[0.05]"
    >
      <span
        class="h-2 w-2 rounded-full bg-gradient-to-br from-celestial-violet to-celestial-cyan shadow-glow-sm transition-transform group-hover:scale-125"
      >
      </span>
      <span class="font-mono text-xs tracking-wider text-slate-200">
        andrew<span class="text-celestial-cyan">.jian</span>
      </span>
    </a>

    <!-- Workspace pills (1-5); each doubles as a section anchor link. -->
    <div class="relative flex items-center gap-1 overflow-x-auto">
      <!-- Sliding workspace indicator (spec #12); repositioned by setActive() in the layout script. -->
      <span
        data-nav-indicator
        class="pointer-events-none absolute inset-y-0 rounded-full border border-white/10 bg-white/[0.06] opacity-0 shadow-[0_0_10px_rgba(168,85,247,0.25)] transition-all duration-300 ease-out"
      ></span>
      {
        links.map((link) => (
          <a
            data-nav-link
            href={`#${link.id}`}
            class="group relative flex items-center gap-1.5 rounded-full border border-transparent px-2.5 py-1 font-mono text-[11px] text-slate-400 transition-all hover:border-white/10 hover:bg-white/[0.05] hover:text-slate-200 data-[active=true]:text-slate-100"
          >
            <span class="text-slate-500 transition-colors group-hover:text-celestial-violet group-data-[active=true]:text-celestial-violet">
              {link.ws}
            </span>
            <span class="hidden sm:inline">{link.label}</span>
            <span
              class="h-1.5 w-1.5 rounded-full bg-white/15 transition-all group-hover:bg-celestial-violet/60 group-data-[active=true]:bg-emerald-400 group-data-[active=true]:shadow-[0_0_8px_rgba(52,211,153,0.8)]"
            />
          </a>
        ))
      }
    </div>

    <!-- Status module: pulsing "available" badge linking to the experience window. -->
    <Tooltip content="Open to opportunities" position="bottom" variant="spring" class="hidden! md:block!">
      <a
        href="#experience"
        class="hidden shrink-0 items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/[0.06] px-3 py-1 transition-colors hover:bg-emerald-400/[0.12] md:flex"
      >
        <span class="h-1.5 w-1.5 animate-pulse-dot rounded-full bg-emerald-400"></span>
        <span class="font-mono text-[11px] tracking-wide text-emerald-300">available</span>
      </a>
    </Tooltip>
  </nav>
</header>
