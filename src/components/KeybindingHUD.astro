---
/**
 * @component KeybindingHUD
 * @description Floating bottom-right shortcut widget. A titled glass box that
 *              lists "Keybindings:" over mechanical-keycap `<kbd>` hints for
 *              navigation and workspace jumps. The HUD flashes (`.hud-flash`)
 *              whenever a hotkey fires via the layout's window-manager script.
 * @remarks     Rendered `pointer-events-none` and hidden on small viewports; it
 *              is purely a visual affordance and never captures input.
 */
const combos = [
  { keys: ['Z', 'Q'], label: 'home' },
  { keys: ['Z', '1'], label: 'about' },
  { keys: ['Z', '2'], label: 'exp' },
  { keys: ['Z', '3'], label: 'projects' },
  { keys: ['Z', '4'], label: 'certs' },
  { keys: ['Z', '5'], label: 'skills' },
];
---

<div
  id="keybinding-hud"
  class="pointer-events-none fixed bottom-5 right-5 z-50 hidden max-w-[18rem] rounded-2xl md:block"
>
  <div
    class="overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04] shadow-panel backdrop-blur-2xl"
  >
    <!-- HUD title bar with the keyboard icon and "Keybindings:" label. -->
    <div
      class="flex items-center gap-2 border-b border-white/10 bg-white/[0.03] px-3 py-1.5"
    >
      <span class="font-nerd text-sm text-celestial-violet" aria-hidden="true">󰌌</span>
      <span class="font-mono text-[11px] tracking-wide text-slate-300">Keybindings:</span>
    </div>

    <div class="px-3 py-2.5">
      <!-- Global navigation hints: arrow-key window cycling and Escape to close. -->
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5">
        <div class="flex items-center gap-1">
          <kbd class="kbd">↓</kbd>
          <kbd class="kbd">↑</kbd>
          <span class="ml-0.5 font-mono text-[11px] text-slate-400">Navigate</span>
        </div>
        <div class="flex items-center gap-1">
          <kbd class="kbd">Esc</kbd>
          <span class="ml-0.5 font-mono text-[11px] text-slate-400">Close</span>
        </div>
      </div>

      <!-- Workspace jump combos: Z + <key> shortcuts mirroring the dock pills. -->
      <div
        class="mt-2 flex flex-wrap items-center gap-x-2.5 gap-y-1.5 border-t border-white/10 pt-2"
      >
        {
          combos.map((combo) => (
            <div class="flex items-center gap-1">
              <kbd class="kbd">{combo.keys[0]}</kbd>
              <span class="font-mono text-[10px] text-ink-faint">+</span>
              <kbd class="kbd">{combo.keys[1]}</kbd>
              <span class="ml-0.5 font-mono text-[11px] text-slate-400">{combo.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
