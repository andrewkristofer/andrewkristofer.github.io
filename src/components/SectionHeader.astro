---
/**
 * @component SectionHeader
 * @description Consistent section opener: a Waybar-style pill kicker (index +
 *              label) followed by the main heading, a gradient hairline, and an
 *              optional supporting paragraph.
 * @prop {string} index - Zero-padded section index rendered in the pill (e.g. "01").
 * @prop {string} label - Short section label rendered in the pill (e.g. "about").
 * @prop {string} title - The main section heading.
 * @prop {string} [sub] - Optional supporting sentence rendered beneath the heading.
 */
interface Props {
  index: string;
  label: string;
  title: string;
  sub?: string;
}

const { index, label, title, sub } = Astro.props;
---

<div class="flex items-center gap-3">
  <span
    class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 font-mono text-[11px] uppercase tracking-[0.2em] text-slate-400"
  >
    <span class="h-1.5 w-1.5 rounded-full bg-gradient-to-r from-celestial-violet to-celestial-cyan">
    </span>
    {index} / {label}
  </span>
  <span class="hairline"></span>
</div>

<h2 class="mt-5 text-3xl font-semibold tracking-tight text-slate-100 md:text-4xl">
  {title}
</h2>

{
  sub && (
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-muted">{sub}</p>
  )
}
