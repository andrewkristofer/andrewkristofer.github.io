---
/**
 * @component AboutWindow
 * @description "About" window: a short narrative bio alongside a 2x2 grid of
 *              animated stat tiles (GPA, thesis accuracy, credentials, months in
 *              production). Composes Window, SectionHeader, and AstroAnimate
 *              primitives (CountUp, HighlightText, FadeInText).
 * @remarks     Spec #7 — the stat tiles count up when the window opens. CountUp
 *              stays dormant while the window is closed thanks to the spec #17
 *              content-visibility gate, then fires exactly once on open.
 */
import Window from '../Window.astro';
import SectionHeader from '../SectionHeader.astro';
import CountUp from '@astroanimate/core/CountUp';
import HighlightText from '@astroanimate/core/HighlightText';
import FadeInText from '@astroanimate/core/FadeInText';

/**
 * Stat-tile definitions rendered in the about grid. Each entry drives a CountUp
 * value (with optional decimals and suffix) plus its label and sub-caption.
 */
const stats = [
  { value: 3.46, decimals: 2, suffix: '', label: 'GPA / 4.00', sub: 'Universitas Indonesia' },
  { value: 87.96, decimals: 2, suffix: '%', label: 'IDS accuracy', sub: 'Federated Learning thesis' },
  { value: 5, decimals: 0, suffix: '', label: 'pro credentials', sub: 'Oracle · Cisco · PMCP' },
  { value: 3, decimals: 0, suffix: '', label: 'months in prod', sub: 'PT Adaro Logistics' },
];
---

<Window id="about" ws="2" title="about" path="~/andrew/about" size="lg">
  <SectionHeader
    index="01"
    label="about"
    title="Hardware-level thinking, human-facing software."
  />

  <div class="mt-10 grid gap-10 md:grid-cols-2">
    <div class="space-y-5 text-base leading-relaxed text-slate-400">
      <p>
        I'm a Computer Engineering graduate from
        <span class="text-slate-200">Universitas Indonesia</span>
        with a foundation that spans the full stack of the discipline: data
        science, IT security, web programming, and computer networks. My path
        runs through the intersection of how systems actually work and how
        people actually use them.
      </p>
      <p>
        During my internship at
        <HighlightText trigger="hover" variant="underline" color="#a855f7" className="text-slate-200">PT Adaro Logistics</HighlightText> I worked on
        enterprise-scale logistics web applications and SQL data pipelines,
        optimizing queries, cutting system load times, and hunting root causes
        of anomalies in production. That's where I learned real engineering is
        <HighlightText trigger="hover" variant="underline" color="#a855f7" className="text-slate-200">continuous improvement</HighlightText>: small,
        measurable wins compounded across a system.
      </p>
      <p>
        My undergraduate thesis pushed that mindset into research:
        benchmarking ML algorithms on the CIC-IDS2017 dataset and designing a
        federated learning intrusion detection system that reaches
        <HighlightText trigger="hover" variant="underline" color="#06b6d4" className="text-celestial-cyan">87.96% accuracy</HighlightText>
        without centralizing sensitive payloads. I care about
        privacy-preserving architecture, cross-functional execution, and
        shipping things that hold up under load.
      </p>
    </div>

    <!-- Stat tiles (spec #7): count up on open + replay pop-in via spec #17. -->
    <div class="grid grid-cols-2 gap-4">
      {
        stats.map((stat, i) => (
          <FadeInText
            as="div"
            duration={0.5}
            delay={0.05 + i * 0.07}
            yOffset={14}
            blur="6px"
            class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 backdrop-blur-xl transition-colors hover:border-white/20"
          >
            <div class="font-mono text-2xl font-semibold text-slate-100">
              <CountUp
                value={stat.value}
                decimals={stat.decimals}
                suffix={stat.suffix}
                duration={1600}
                mainClassName="text-2xl! font-semibold! font-mono! text-slate-100!"
                enhance
              />
            </div>
            <div class="mt-1 font-mono text-[11px] uppercase tracking-wider text-celestial-cyan">
              {stat.label}
            </div>
            <div class="mt-2 text-xs leading-relaxed text-ink-faint">
              {stat.sub}
            </div>
          </FadeInText>
        ))
      }
    </div>
  </div>
</Window>
