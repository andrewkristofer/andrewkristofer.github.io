---
import Window from '../Window.astro';
import SectionHeader from '../SectionHeader.astro';

const certGroups = [
  {
    label: 'network & security',
    items: [
      {
        name: 'Cisco CCNA Series',
        detail: 'Intro to Networks · Switching · Enterprise',
        meta: 'Cisco · Jul 2024',
        dot: 'bg-celestial-cyan',
      },
      {
        name: 'Cybersecurity Specializations',
        detail: 'Google Cloud · Microsoft · IBM · Cisco',
        meta: 'Nov 2025',
        dot: 'bg-sky-400',
      },
    ],
  },
  {
    label: 'data science & gen ai',
    items: [
      {
        name: 'OCI 2025 Certified Data Science & Gen AI Pro',
        detail: 'Oracle Cloud Infrastructure',
        meta: 'Oracle · Oct 2025',
        dot: 'bg-celestial-violet',
      },
      {
        name: 'Machine Learning with Python',
        detail: 'Cognitive Class',
        meta: 'IBM · Mar 2025',
        dot: 'bg-fuchsia-400',
      },
    ],
  },
  {
    label: 'project management',
    items: [
      {
        name: 'Project Management Certified Practitioner (PMCP)',
        detail: 'PT Sinergi Daya Mitra',
        meta: 'May 2026',
        dot: 'bg-emerald-400',
      },
    ],
  },
];
---

<Window id="certifications" ws="5" title="certifications" path="~/andrew/certs" size="lg">
  <SectionHeader
    index="04"
    label="certifications"
    title="Verified credentials."
    sub="Global certifications across AI, networking, security, and project execution."
  />

  <div class="mt-10 space-y-8">
    {
      certGroups.map((group) => (
        <div>
          <div class="flex items-center gap-3">
            <span class="font-mono text-[11px] uppercase tracking-[0.25em] text-ink-faint">
              // {group.label}
            </span>
            <span class="h-px flex-1 bg-white/5" />
          </div>
          <div class="mt-4 flex flex-wrap gap-3">
            {group.items.map((cert) => (
              <div class="flex items-center gap-3 rounded-full border border-white/10 bg-white/[0.04] py-2 pl-3 pr-5 backdrop-blur-xl transition-all hover:border-white/20 hover:bg-white/[0.07]">
                <span class={`h-2 w-2 shrink-0 rounded-full ${cert.dot}`} />
                <div>
                  <div class="text-sm font-medium text-slate-200">{cert.name}</div>
                  <div class="font-mono text-[11px] text-ink-faint">
                    {cert.detail} <span class="text-ink-faint/60">·</span> {cert.meta}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Window>
