---
import Window from '../Window.astro';
import SectionHeader from '../SectionHeader.astro';
import GlassCard from '../GlassCard.astro';
import HighlightText from '@astroanimate/core/HighlightText';
---

<Window id="projects" ws="4" title="projects" path="~/andrew/projects" size="xl">
  <SectionHeader
    index="03"
    label="projects"
    title="Things I've designed, built, and debugged."
    sub="Research prototypes and production-minded apps: privacy-first, typed end-to-end."
  />

  <div class="mt-10 grid gap-5 md:grid-cols-2">
    <GlassCard
      kicker="01 / undergraduate thesis"
      title="Federated Learning IDS"
      href="https://github.com/andrewkristofer/FL-IDS-CICIDS2017"
      tags={['Python', 'Machine Learning', 'Federated Learning', 'CIC-IDS2017', 'Security']}
    >
      <p>
        Evaluated and benchmarked multiple ML algorithms on the massive
        CIC-IDS2017 dataset, extracting the architectural strengths of the
        top three models, then synthesized those insights into a novel,
        privacy-preserving Intrusion Detection System built on Federated
        Learning.
      </p>
      <p class="mt-3">
        Detects network threats at
        <HighlightText trigger="hover" variant="underline" color="#06b6d4" className="font-mono text-celestial-cyan">87.96% accuracy</HighlightText>
        without ever centralizing sensitive payload data.
      </p>
    </GlassCard>

    <GlassCard
      kicker="02 / full-stack app"
      title="TaskFlow"
      href="https://github.com/andrewkristofer/TaskFlow"
      tags={['Next.js', 'TypeScript', 'PostgreSQL', 'React']}
    >
      <p>
        A focused task and workflow manager with typed data flow from
        database to UI. Next.js and TypeScript on the front, PostgreSQL for
        durable relational state.
      </p>
      <p class="mt-3">
        Built for speed and strictness: server-rendered views, end-to-end
        types, and clean CRUD over a normalized schema.
      </p>
    </GlassCard>

    <GlassCard
      kicker="03 / privacy-first ai"
      title="SafeJournal"
      href="https://github.com/andrewkristofer/SafeJournal"
      tags={['Web Crypto API', 'Privacy', 'AI', 'JavaScript']}
    >
      <p>
        A journaling companion where privacy is the default, not a setting.
        Entries are encrypted client-side with the Web Crypto API before
        they ever touch storage.
      </p>
      <p class="mt-3">
        AI-assisted features operate on data the user controls. No
        plaintext leaves the device.
      </p>
    </GlassCard>

    <GlassCard
      kicker="04 / utility"
      title="SubMane"
      href="https://github.com/andrewkristofer/SubMane"
      tags={['Web App', 'Tracking', 'Dashboard', 'CRUD']}
    >
      <p>
        A resource and subscription tracker that keeps recurring costs and
        allocations visible in one place: what you're paying for, when it
        renews, and what it's actually using.
      </p>
      <p class="mt-3">
        Designed around fast scanning: a single dashboard view instead of
        scattered spreadsheets.
      </p>
    </GlassCard>
  </div>
</Window>
