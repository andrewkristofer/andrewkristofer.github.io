---
/**
 * @file        index.astro
 * @description Landing page for the Andrew Kristofer Jian portfolio. Renders the
 *              hero "desktop" (status pill, name, typewriter roles, CTA buttons,
 *              and tech ticker) and mounts the five tiling-window sections.
 * @remarks     Windows are shown one at a time by the layout's window-manager
 *              script; this page supplies their hero copy and content.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutWindow from '../components/windows/AboutWindow.astro';
import ExperienceWindow from '../components/windows/ExperienceWindow.astro';
import ProjectsWindow from '../components/windows/ProjectsWindow.astro';
import CertsWindow from '../components/windows/CertsWindow.astro';
import SkillsWindow from '../components/windows/SkillsWindow.astro';
import FadeInText from '@astroanimate/core/FadeInText';
import TypewriterText from '@astroanimate/core/TypewriterText';
import HighlightText from '@astroanimate/core/HighlightText';
import AnimatedButton from '@astroanimate/core/AnimatedButton';
import InfiniteMarquee from '@astroanimate/core/InfiniteMarquee';
import Tooltip from '@astroanimate/core/Tooltip';

/**
 * Role phrases cycled by the hero typewriter effect (spec #2).
 */
const roles = [
  'Computer Engineering Graduate',
  'Enterprise Systems Engineer',
  'Privacy-Preserving ML Researcher',
  'Continuous Improver',
];

/**
 * Technology keywords streamed through the hero marquee ticker (spec #15).
 */
const ticker = [
  'PHP',
  'Python',
  'SQL',
  'PostgreSQL',
  'JavaScript',
  'TypeScript',
  'Next.js',
  'Data Pipelines',
  'Machine Learning',
  'Federated Learning',
  'Cisco Networking',
  'IT Security',
];

/**
 * Social and contact links rendered as icon buttons in the hero CTA row. Each
 * entry supplies a label, tooltip text, target URL, and an SVG path icon.
 */
const socials = [
  {
    label: 'GitHub',
    tip: 'GitHub · @andrewkristofer',
    href: 'https://github.com/andrewkristofer',
    icon: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  },
  {
    label: 'LinkedIn',
    tip: 'LinkedIn · andrewkristoferjian',
    href: 'https://linkedin.com/in/andrewkristoferjian',
    icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
  {
    label: 'Email',
    tip: 'Email · andrewjian4@gmail.com',
    href: 'mailto:andrewjian4@gmail.com',
    icon: 'M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z',
  },
];
---

<BaseLayout
  title="Andrew Kristofer Jian · Computer Engineering Graduate"
  description="Portfolio of Andrew Kristofer Jian, Computer Engineering graduate (Universitas Indonesia) specializing in enterprise systems, data pipelines, and privacy-preserving machine learning."
>
  <!-- ============================================================= -->
  <!-- Section: #home — the desktop (hero)                            -->
  <!-- ============================================================= -->
  <section id="home" class="relative flex min-h-screen items-center px-6 pb-24 pt-36">
    <div class="mx-auto w-full max-w-5xl">
      <!-- Status pill: pulsing "Available for roles" badge. -->
      <FadeInText
        as="div"
        duration={0.55}
        delay={0}
        yOffset={16}
        blur="8px"
        class="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/[0.06] px-3 py-1"
      >
        <span class="h-1.5 w-1.5 animate-pulse-dot rounded-full bg-emerald-400"></span>
        <span class="font-mono text-[11px] tracking-wide text-emerald-300">
          Available for roles
        </span>
      </FadeInText>

      <FadeInText
        as="h1"
        duration={0.6}
        delay={0.12}
        yOffset={22}
        blur="10px"
        class="mt-6 text-5xl font-semibold leading-tight tracking-tight text-slate-100 md:text-7xl"
      >
        Andrew Kristofer
        <span
          class="bg-gradient-to-r from-celestial-violet via-fuchsia-400 to-celestial-cyan bg-clip-text text-transparent"
        >
          Jian
        </span>
      </FadeInText>

      <!-- Typewriter role line (spec #2): cycles through the role phrases. -->
      <FadeInText
        as="p"
        duration={0.55}
        delay={0.22}
        yOffset={16}
        blur="8px"
        class="mt-3 font-mono text-sm tracking-wide text-ink-muted"
      >
        <TypewriterText
          texts={roles}
          enhance
          typeSpeed={60}
          eraseSpeed={30}
          pauseAfter={1600}
          mainClassName="text-slate-200"
        />
      </FadeInText>
      <FadeInText
        as="p"
        duration={0.55}
        delay={0.3}
        yOffset={14}
        blur="8px"
        class="mt-2 font-mono text-xs tracking-wide text-ink-faint"
      >
        Universitas Indonesia <span class="text-ink-faint">·</span>
        GPA <span class="text-celestial-cyan">3.46</span>/4.00
      </FadeInText>

      <FadeInText
        as="p"
        duration={0.65}
        delay={0.4}
        yOffset={18}
        blur="8px"
        class="mt-8 max-w-2xl text-lg leading-relaxed text-slate-300 md:text-xl"
      >
        I engineer fast, reliable systems: from
        <HighlightText trigger="load" delay="550ms" color="rgba(168, 85, 247, 0.32)" className="text-slate-100">enterprise logistics pipelines</HighlightText>
        at PT Adaro Logistics to
        <HighlightText trigger="load" delay="750ms" color="rgba(6, 182, 212, 0.30)" className="text-slate-100">privacy-preserving machine learning</HighlightText>
        research. Computer engineering with a continuous-improvement mindset.
      </FadeInText>

      <!-- Primary CTAs: CV download button plus social/contact icon links. -->
      <FadeInText
        as="div"
        duration={0.6}
        delay={0.52}
        yOffset={18}
        blur="8px"
        class="mt-10 flex flex-wrap items-center gap-3"
      >
        <!-- Shimmer CTA (spec #5): animated CV download button. -->
        <AnimatedButton
          variant="shimmer"
          href="/andrew-kristofer-jian-cv.pdf"
          download=""
          shimmerColor="rgba(255, 255, 255, 0.35)"
          class="group inline-flex items-center gap-2.5 rounded-full! border-0! bg-gradient-to-r! from-celestial-violet to-celestial-cyan px-5! py-2.5! font-mono! text-sm! font-medium! text-white shadow-glow! hover:scale-[1.03] hover:shadow-glow-cyan!"
        >
          <span class="text-base leading-none">↓</span>
          Download CV
          <span class="rounded-full bg-black/20 px-2 py-0.5 text-[11px] text-white/80">
            cv.pdf
          </span>
        </AnimatedButton>

        {
          socials.map((social) => (
            <Tooltip content={social.tip} position="top" variant="fade">
              <a
                href={social.href}
                target={social.href.startsWith('http') ? '_blank' : undefined}
                rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                aria-label={social.label}
                class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-slate-300 backdrop-blur-xl transition-all hover:border-celestial-violet/40 hover:bg-white/[0.08] hover:text-slate-100 hover:shadow-glow-sm"
              >
                <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
                  <path d={social.icon} />
                </svg>
              </a>
            </Tooltip>
          ))
        }
      </FadeInText>

      <!-- Launch hint: keyboard prompt for opening windows from the dock. -->
      <FadeInText
        as="div"
        duration={0.6}
        delay={0.64}
        yOffset={16}
        blur="8px"
        class="mt-14 flex items-center gap-2"
      >
        <kbd class="kbd">↓</kbd>
        <span class="font-mono text-xs text-ink-faint">
          open a window from the dock above, or press Z + 1…5
        </span>
      </FadeInText>
    </div>

    <!-- Tech ticker (spec #15): infinite marquee of technology keywords. -->
    <FadeInText
      as="div"
      duration={0.8}
      delay={0.8}
      yOffset={18}
      class="absolute inset-x-6 bottom-8 z-10 md:right-[21rem]"
    >
      <InfiniteMarquee speed="45s" gap="2.5rem" fade mainClassName="w-full">
        {
          ticker.map((tech) => (
            <span class="marquee-item rounded-full! px-3! py-1.5! font-mono! text-[11px]!">
              {tech}
            </span>
          ))
        }
      </InfiniteMarquee>
    </FadeInText>
  </section>

  <!-- ============================================================= -->
  <!-- Windows: the five tiling-window sections, shown one at a time  -->
  <!-- ============================================================= -->
  <AboutWindow />
  <ExperienceWindow />
  <ProjectsWindow />
  <CertsWindow />
  <SkillsWindow />
</BaseLayout>
